# Smart Form Filler Configuration
# Copy this file to .env and fill in your details

# ===========================================
# API KEYS (Required)
# ===========================================

# Groq API (FREE - https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Telegram Bot (for notifications)
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ===========================================
# PERSONAL INFORMATION (Required for auto-fill)
# ===========================================

FULL_NAME=Your Full Name
FIRST_NAME=Your First Name
LAST_NAME=Your Last Name
EMAIL=your.email@example.com
PHONE=+1234567890

# Social Links
LINKEDIN=linkedin.com/in/yourprofile
GITHUB=github.com/yourusername
PORTFOLIO=yourportfolio.com

# Location
LOCATION=Your City, Country
CITY=Your City
COUNTRY=Your Country
TIMEZONE=UTC+7 (WIB)

# Work Preferences
DESIRED_ROLE=Web3 Developer / DeFi Engineer
WORK_TYPE=Remote / Contract
EXPECTED_SALARY=30-50 USD/hour
AVAILABILITY=Immediately
START_DATE=Immediately

# Experience
YEARS_EXPERIENCE=7+
EDUCATION=Bachelor's Degree

# Skills (comma-separated)
SKILLS=Python,JavaScript,TypeScript,React,Next.js,Node.js,Solidity,Rust,Solana,Web3,DeFi

# Languages (comma-separated)
LANGUAGES=Indonesian (Native),English (Conversational)

# Work Authorization
AUTHORIZED_TO_WORK=Yes, remote/contract
REQUIRES_SPONSORSHIP=No
VISA_STATUS=N/A - Remote work

# ===========================================
# OPTIONAL SETTINGS
# ===========================================

# OpenAI (if using GPT instead of Groq)
# OPENAI_API_KEY=your_openai_key_here

# Anthropic (if using Claude)
# ANTHROPIC_API_KEY=your_anthropic_key_here
